# Normalize line endings in the repository; check out LF everywhere.
* text=auto eol=lf

# Binary assets: never diff, merge, or convert.
*.gguf binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.sqlite binary
*.sqlite3 binary

# Text assets that benefit from explicit LF handling.
*.svg text eol=lf
*.sh text eol=lf
