{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Herald",
  "version": "0.1.0",
  "identifier": "com.herald.desktop",
  "build": {
    "frontendDist": "src-ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/icon.png",
      "icons/icon-128.png",
      "icons/icon-256.png",
      "icons/icon-512.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "category": "Utility",
    "shortDescription": "Herald desktop shell",
    "longDescription": "A desktop window around `herald ui`. The shell spawns the herald CLI's loopback server and shows its page; all logic and approvals stay in the CLI.",
    "externalBin": ["binaries/herald"]
  }
}
